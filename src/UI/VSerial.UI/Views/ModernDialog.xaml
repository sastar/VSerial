<Window x:Class="VSerial.UI.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFontFamily}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 外层发光与投影卡片 -->
    <Border Margin="14"
            Background="#FFFFFF"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#000000"
                              Opacity="0.18"
                              ShadowDepth="4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" /> <!-- 顶栏 -->
                <RowDefinition Height="*" />  <!-- 内容区 -->
                <RowDefinition Height="64" /> <!-- 底部操作按钮 -->
            </Grid.RowDefinitions>

            <!-- 1. 现代化简明顶栏 -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <DockPanel LastChildFill="True" Margin="16,0,8,0">
                    <Button DockPanel.Dock="Right"
                            Width="28" Height="28"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. 内容正文区 -->
            <Grid Grid.Row="1" Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 图标展示 -->
                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{Binding IconBackgroundBrush}"
                        VerticalAlignment="Top"
                        Margin="0,2,18,0">
                    <TextBlock Text="{Binding IconGlyph}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 消息文本 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding MessageText}"
                           FontSize="13.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 3. 底部按钮操作栏 -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- 取消按钮 (仅在确认模式显示) -->
                    <Button x:Name="CancelBtn"
                            Style="{StaticResource ModernButtonStyle}"
                            Content="{DynamicResource Btn_Cancel}"
                            Width="84"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Visibility="{Binding IsConfirmMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- 确认/主按钮 -->
                    <Button x:Name="OkBtn"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding PrimaryButtonText}"
                            Width="90"
                            Height="34"
                            IsDefault="True"
                            Click="OkButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
