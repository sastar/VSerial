<Window x:Class="VSerial.UI.Views.CreatePairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VSerial.UI.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Title_CreateDialog}"
        SizeToContent="Height"
        Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource MainFontFamily}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.DataContext>
        <viewmodels:CreatePairViewModel />
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 卡片主体外框 -->
    <Border Margin="14"
            Background="#FFFFFF"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Color="#000000"
                              Opacity="0.18"
                              ShadowDepth="4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- 顶栏 -->
                <RowDefinition Height="*" />  <!-- 内容表单 -->
                <RowDefinition Height="64" /> <!-- 底部操作栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 现代化简明顶栏 -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <DockPanel LastChildFill="True" Margin="18,0,10,0">
                    <Button DockPanel.Dock="Right"
                            Width="28" Height="28"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CancelButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{DynamicResource Title_CreateDialog}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. 表单主体区 -->
            <StackPanel Grid.Row="1" Margin="24,20,24,12">
                <!-- 提示说明框 -->
                <Border Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{DynamicResource Create_BannerTip}"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="#166534"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 配对组 ID 设置 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Create_PairIdLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding PairId, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             FontSize="13"
                             Padding="8,5"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             VerticalContentAlignment="Center" />
                </Grid>

                <!-- 端口选择交互卡片 (A 端 ⇄ B 端) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- A 端串口 -->
                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Create_PortALabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                      Text="{Binding PortA, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Height="34"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 双向箭头指示 -->
                    <TextBlock Grid.Column="1"
                               Text="⇄"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- B 端串口 -->
                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Create_PortBLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                      Text="{Binding PortB, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Height="34"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 校验错误提示条 (仅在存在输入错误时显示) -->
                <Border Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ValidationError}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. 底部操作按钮栏 -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="18,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Content="{DynamicResource Btn_Cancel}"
                            Width="84"
                            Height="34"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click" />

                    <Button Style="{StaticResource SuccessButtonStyle}"
                            Content="{DynamicResource Btn_CreateNow}"
                            Width="96"
                            Height="34"
                            IsEnabled="{Binding IsValid}"
                            IsDefault="True"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
