<Window x:Class="VSerial.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VSerial.UI.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource App_Title}"
        Icon="Assets/vserial.png"
        Height="660" Width="1000"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="{StaticResource MainFontFamily}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="14"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 外层发光与圆角主体卡片 (Normal 模式 12px 阴影间距，Maximized 模式 0 贴边) -->
    <Border x:Name="RootBorder"
            Margin="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow"
                              BlurRadius="24"
                              Color="#000000"
                              Opacity="0.16"
                              ShadowDepth="4" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <!-- 主网格结构：现代标题栏、顶栏警告、工具栏、主体表格、状态栏 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />   <!-- 0. 现代化沉浸式标题栏 -->
                <RowDefinition Height="Auto" /> <!-- 1. 非管理员警告条 -->
                <RowDefinition Height="Auto" /> <!-- 2. 顶部工具栏 -->
                <RowDefinition Height="*" />    <!-- 3. 数据内容列表 -->
                <RowDefinition Height="Auto" /> <!-- 4. 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- 0. 现代化自定义标题栏 (Modern Custom TitleBar) -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：图标 + 标题 + 驱动与权限徽章 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 应用图标 -->
                        <Image Source="Assets/vserial.png"
                               Width="32" Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="16,0,8,0"
                               VerticalAlignment="Center" />

                        <!-- 应用名称 -->
                        <TextBlock Text="{DynamicResource App_Title}"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- 技术栈架构徽章 -->
                        <Border Background="#EFF6FF"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource App_ArchitectureBadge}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>

                        <!-- 管理员模式徽章 -->
                        <Border Background="#ECFDF5"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Badge_Admin}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#047857"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 标准权限模式徽章 -->
                        <Border Background="{StaticResource WarningBgBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="{DynamicResource Badge_ReadOnly}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 中间：用于窗口拖拽留白区 (无控件自动成为 Caption 拖动区) -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- 右侧：现代化窗口控制按钮与语言选择器 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <!-- 现代化语言切换选择器 (独立 Fluent 扁平风格与悬浮卡片下拉列表) -->
                        <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                  SelectedItem="{Binding CurrentLanguage}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  VerticalAlignment="Center"
                                  Width="118"
                                  Height="28"
                                  Margin="0,0,12,0"
                                  ToolTip="{DynamicResource Label_Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NativeName}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Style="{StaticResource CaptionButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeButton_Click"
                                ToolTip="{DynamicResource Tip_Minimize}">
                            <TextBlock Text="─" FontSize="11" FontWeight="Bold" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeButton_Click"
                                ToolTip="{DynamicResource Tip_Maximize}">
                            <TextBlock x:Name="MaximizeIconText" Text="☐" FontSize="12" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseCaptionButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseButton_Click"
                                ToolTip="{DynamicResource Tip_Close}">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. 非管理员运行警告横幅 -->
            <Border Grid.Row="1"
                    Background="{StaticResource WarningBgBrush}"
                    BorderBrush="#FCD34D"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="⚠️"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Warn_StandardPrivilege}"
                               Foreground="{StaticResource WarningTextBrush}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <Button Grid.Column="2"
                            Style="{StaticResource WarningButtonStyle}"
                            Padding="12,5"
                            Command="{Binding RestartAsAdminCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Btn_RestartAsAdmin}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. 现代化操作工具栏 -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <!-- 刷新按钮 -->
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Btn_Refresh}" />
                            </StackPanel>
                        </Button>

                        <!-- 新建配对按钮 -->
                        <Button Style="{StaticResource SuccessButtonStyle}"
                                Command="{Binding CreatePairCommand}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Btn_CreatePair}" />
                            </StackPanel>
                        </Button>

                        <!-- 删除选中按钮 -->
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeletePairCommand}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Btn_DeleteSelected}" />
                            </StackPanel>
                        </Button>

                        <!-- 清空所有按钮 -->
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding DeleteAllPairsCommand}"
                                Foreground="#B91C1C"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Btn_DeleteAll}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧驱动管理菜单 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding InstallDriverCommand}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource Tip_InstallDriver}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Btn_InstallDriver}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding UninstallDriverCommand}"
                                Foreground="#B91C1C"
                                ToolTip="{DynamicResource Tip_UninstallDriver}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Btn_UninstallDriver}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. 数据表格内容区域 -->
            <Grid Grid.Row="3" Margin="16">
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <!-- 配对数据表格 (重构高亮与单元格样式，杜绝深蓝色刺眼背景与虚线框) -->
                        <DataGrid ItemsSource="{Binding Pairs}"
                                  SelectedItem="{Binding SelectedPair}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="52"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <DataGrid.Resources>
                                <!-- 覆盖系统原生选中画刷，彻底清除刺眼高对比深蓝色 -->
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E293B" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F8FAFC" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E293B" />
                            </DataGrid.Resources>

                            <!-- 现代表头样式 -->
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <!-- 现代单元格样式 (去除黑色焦点虚线框，背景透传) -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderThickness="0"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <!-- 现代行样式 (淡雅微蓝底色 + 悬浮指示条，零布局挤占，杜绝横向滚动条) -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F1F5F9" />
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridRow">
                                                <Border x:Name="DgrBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <!-- 单元格展示容器严格占满宽度，不受指示条挤占 -->
                                                        <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                                        <!-- 悬浮在最左边缘的指示蓝条，不参与横向宽度挤占 -->
                                                        <Rectangle x:Name="SelectionBar"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Stretch"
                                                                   Width="3.5"
                                                                   Fill="{StaticResource PrimaryBrush}"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DgrBorder" Property="Background" Value="#F8FAFC" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <!-- 优雅柔和的极淡蓝底色，彻底杜绝刺眼深蓝 -->
                                                        <Setter TargetName="DgrBorder" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- 配对标识 -->
                                <DataGridTemplateColumn Header="{DynamicResource Col_PairId}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Margin="16,0,0,0">
                                                <TextBlock Text="{Binding PairId, StringFormat='#{0}'}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Port A 详情 -->
                                <DataGridTemplateColumn Header="{DynamicResource Col_PortA}" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                                <!-- 状态指示圆点 -->
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding PortA.IsStarted, Converter={StaticResource PairStatusToBrushConverter}}"
                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PortA.PortName}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PortA, Converter={StaticResource PortStatusToTextConverter}}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 互联指示箭头 -->
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="⇄"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Port B 详情 -->
                                <DataGridTemplateColumn Header="{DynamicResource Col_PortB}" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                                <!-- 状态指示圆点 -->
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding PortB.IsStarted, Converter={StaticResource PairStatusToBrushConverter}}"
                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PortB.PortName}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PortB, Converter={StaticResource PortStatusToTextConverter}}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 综合状态胶囊徽章 (充足列宽与间距，彻底消除文字切边截断) -->
                                <DataGridTemplateColumn Header="{DynamicResource Col_Status}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Padding="12,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource PairStatusToBrushConverter}}"
                                                    Opacity="0.9"
                                                    Margin="12,0">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource PairStatusToTextConverter}}"
                                                           Foreground="#FFFFFF"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 单项操作列 -->
                                <DataGridTemplateColumn Header="{DynamicResource Col_Action}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DangerButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Content="{DynamicResource Btn_DeleteRow}"
                                                    Command="{Binding DataContext.DeletePairCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="16,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 空列表状态占位提示 (仅在没有虚拟串口时显示) -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="🔌" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="{DynamicResource Empty_Title}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{DynamicResource Empty_Desc}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. 底部状态栏 -->
            <Border x:Name="StatusBarBorder"
                    Grid.Row="4"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧驱动状态指示 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding DriverStatus.IsInstalled, Converter={StaticResource PairStatusToBrushConverter}}"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DriverStatus, Converter={StaticResource DriverStatusToTextConverter}}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 中间业务动作提示 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0" />

                    <!-- 右侧刷新时间 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Status_LastUpdated}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastRefreshTime}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. 全局异步操作遮罩层 -->
            <Grid Grid.Row="0" Grid.RowSpan="5"
                  Background="#66000000"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#FFFFFF"
                        CornerRadius="10"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="320"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Margin="0,0,0,16"
                                     Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>
